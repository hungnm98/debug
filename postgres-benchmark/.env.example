# Run: cd postgres-benchmark; cp .env.example .env; edit .env; source .env
export PGHOST=db.example.internal
export PGPORT=5444
export PGDATABASE=benchmark
export PGUSER=benchmark_owner
export PGPASSFILE="$PWD/.pgpass"
export PGSSLMODE=require
export PGSSLROOTCERT="$PWD/certs/psql-ca.crt"
export PGCONNECT_TIMEOUT=8
export ROWS=2000000
export DURATION=120
export CLIENTS="1 16 64"
export RESULTS_ROOT="$PWD/pgbench-results"
